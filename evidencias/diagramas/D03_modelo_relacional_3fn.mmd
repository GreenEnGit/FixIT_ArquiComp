    activities {
        bigint id PK
        varchar ticket_id FK
        text action
        timestamp time
        varchar branch_id FK
    }
    appointments {
        bigint id PK
        varchar customer_name
        varchar service
        date date
        time time
        varchar status
        varchar branch_id FK
    }
    audit_logs {
        bigint id PK
        varchar username
        varchar action
        varchar item_id
        text details
        numeric monetary_impact
        timestamp date
        varchar branch_id FK
        jsonb old_data
        jsonb new_data
    }
    branches {
        varchar id PK
        varchar name
        numeric tax_rate
    }
    customer_devices {
        varchar id PK
        varchar customer_id FK
        varchar type
        varchar model
        varchar serial_number
        text condition
        bytea password
        varchar branch_id FK
    }
    customers {
        varchar id PK
        varchar name
        varchar phone
        varchar email
        varchar address
    }
    inventory {
        varchar id PK, FK
        int stock
        numeric cost
        numeric price
        varchar branch_id PK, FK
    }
    knowledge_base {
        int id PK
        varchar title
        text keywords
        text content
        varchar category
    }
    loaners {
        varchar id PK
        varchar type
        varchar model
        varchar status
        varchar branch_id FK
    }
    payments {
        bigint id PK
        varchar ticket_id FK
        numeric amount
        varchar method
        date date
    }
    products {
        varchar id PK
        varchar name
        varchar brand
        varchar category
        jsonb specs
        varchar image_path
    }
    purchase_orders {
        bigint id PK
        varchar vendor_id FK
        varchar part_id FK
        int qty
        varchar status
        date date
    }
    sale_items {
        bigint id PK
        bigint sale_id FK
        varchar item_id FK
        int qty
        numeric price
        numeric subtotal
    }
    sales {
        bigint id PK
        numeric total
        timestamp date
        varchar branch_id FK
        varchar username FK
        text status
    }
    ticket_images {
        bigint id PK
        varchar ticket_id FK
        varchar file_path
    }
    ticket_parts {
        bigint id PK
        varchar ticket_id FK
        varchar part_id FK
        varchar name
        int qty
        numeric cost
        numeric price
    }
    tickets {
        varchar id PK
        varchar status
        varchar customer_id FK
        varchar device_id FK
        text symptom
        date date
        numeric labor_cost
        varchar branch_id FK
    }
    user_disk_quotas {
        varchar role_name PK
        bigint max_bytes
        bigint used_bytes
        timestamp_with_time_zone updated_at
    }
    users {
        int id PK
        varchar username UK
        varchar password_hash
        varchar role
        varchar branch_id FK
    }
    vendors {
        varchar id PK
        varchar name
        varchar contact
    }
    warranties {
        bigint id PK
        varchar ticket_id FK
        date start_date
        date end_date
        text notes
    }