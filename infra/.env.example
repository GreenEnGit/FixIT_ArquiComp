# FixIT_ArquiComp — Variables de entorno para Podman Compose (fixit_pg_master)
# Copia este archivo como infra/.env (gitignored) — init_env.sh lo hace
# automaticamente y además REEMPLAZA cada CHANGE_ME por una contraseña
# aleatoria unica en la primera ejecucion. No pongas contraseñas reales
# aqui ni en ningun archivo versionado.
#
# SCB-1001 U2.T2.S5 — Variables de Ambiente y archivos importantes para instalacion

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
POSTGRES_DB=fixit_db

# Contraseñas de los roles RBAC creados por src/sql/03_roles_and_quotas.sh
# (ver DICCIONARIO_DATOS.md para el detalle de cada rol). init_env.sh las
# genera automaticamente si quedan en CHANGE_ME.
ADMIN_SYS_PASSWORD=CHANGE_ME
APP_TECNICO_PASSWORD=CHANGE_ME
APP_RECEPCION_PASSWORD=CHANGE_ME
APP_AUDITOR_PASSWORD=CHANGE_ME
REPLICATOR_PASSWORD=CHANGE_ME
